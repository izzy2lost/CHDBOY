<?xml version="1.0" encoding="utf-8"?>
<!--
    Status bar icon: the outer contour of the Material "bolt" glyph, filled.

    Two deliberate differences from @drawable/ic_bolt, which is the same glyph
    used inside the app:

      - No theme attribute tint. SystemUI inflates this in its own context, so
        ?attr/colorControlNormal is not guaranteed to resolve there.
      - Solid rather than outlined. Android reduces this to a flat silhouette
        from the alpha channel, and the outlined glyph's interior counter reads
        as a thin sliver at status bar size.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="960"
    android:viewportHeight="960">
  <path
      android:fillColor="#FFFFFFFF"
      android:pathData="M320,880L360,600L160,600L520,80L600,80L560,400L800,400L400,880L320,880Z"/>
</vector>
