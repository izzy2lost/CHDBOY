<PreferenceScreen
    xmlns:app="http://schemas.android.com/apk/res-auto">
    
    <PreferenceCategory
        app:title="@string/settings_category_general" >

        <SwitchPreferenceCompat
            app:key="deletesource"
            app:title="@string/settings_delete_source_title"
            app:summary="@string/settings_delete_source_summary"
            app:defaultValue="false" />

        <ListPreference
            app:key="theme"
            app:title="@string/settings_theme_title"
            app:defaultValue="Follow System"
            app:entries="@array/themes"
            app:entryValues="@array/themes" />
        
    </PreferenceCategory>     
    
</PreferenceScreen>